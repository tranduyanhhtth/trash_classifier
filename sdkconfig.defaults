# =============================================================================
# sdkconfig.defaults  –  ESP32-S3 N16R8 (16MB Flash + 8MB Octal PSRAM)
# =============================================================================

# ── Flash: 16MB ──────────────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Partition table: use a custom one that uses the full 16MB
# (see partitions.csv – already included in the project)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── CPU: 240 MHz ──────────────────────────────────────────────────────────────
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ── PSRAM: 8MB Octal (OPI) ───────────────────────────────────────────────────
# N16R8 uses Octal SPI PSRAM (the "R8" part)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Allow TFLite tensor arena to fall back to PSRAM if SRAM is full
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Allow FreeRTOS task stacks in PSRAM (useful for future expansion)
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# ── Cache optimisation (important for TFLite inference speed) ─────────────────
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ── Camera task affinity ──────────────────────────────────────────────────────
# Run camera DMA/capture on Core 1 so TFLite inference (Core 0) is not blocked
CONFIG_CAMERA_CORE1=y

# ── Camera board selection ────────────────────────────────────────────────────
# Uncomment the line that matches YOUR board.
# If your board is not listed, use CUSTOM and set pins via idf.py menuconfig.

# Option 1: ESP32-S3-EYE (Espressif official, OV2640, no PSRAM issue)
CONFIG_CAMERA_MODULE_ESP_S3_EYE=y

# Option 2: AI-Thinker style S3 board – uncomment if needed
# CONFIG_CAMERA_MODULE_AI_THINKER=y

# Option 3: Custom board – uncomment and set pins in Kconfig.projbuild
# CONFIG_CAMERA_MODULE_CUSTOM=y

# ── ESP-NN: SIMD-accelerated TFLite kernels ───────────────────────────────────
# Mandatory for good inference performance on S3.
# The ESP32-S3 has vector instructions that speed up Conv2D/DepthwiseConv2D
# by 2-4x compared to the generic reference kernels.
CONFIG_NN_OPTIMIZED=y

# ── Console: USB-Serial JTAG (native USB on S3) ───────────────────────────────
# N16R8 modules usually expose native USB – use it for idf.py monitor
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Fallback if your board wires UART0 to a CH340/CP2102:
# CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# ── Logging ───────────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ── Flash mode ────────────────────────────────────────────────────────────────
# QIO is the standard for most N16R8 modules
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
